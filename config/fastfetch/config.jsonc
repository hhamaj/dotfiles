// Fastfetch — starship/foot/rofi ile aynı macOS dark, monokrom tarz
// fg #f2f2f2 · dim #8e8e93 · faint #636366 · trafik ışıkları en altta
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": { "1": "38;2;99;99;102" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "brightColor": false,
    "key": { "width": 6 },
    "size": { "binaryPrefix": "jedec" },
    "color": {
      "keys": "38;2;142;142;147",
      "title": "1;38;2;242;242;242",
      "output": "38;2;242;242;242",
      "separator": "38;2;99;99;102"
    }
  },
  "modules": [
    "break",
    { "type": "title", "format": "\u001b[1;38;2;242;242;242m{user-name}\u001b[0;38;2;99;99;102m@\u001b[1;38;2;242;242;242m{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;58;58;60m──────────────────────" },
    { "type": "os",     "key": "os",   "format": "{name} {version-id}" },
    { "type": "kernel", "key": "ker" },
    { "type": "wm",     "key": "wm",   "format": "{pretty-name}" },
    { "type": "shell",  "key": "sh",   "format": "{pretty-name}" },
    { "type": "uptime", "key": "up" },
    "break",
    { "type": "cpu",    "key": "cpu",  "format": "{name}" },
    { "type": "memory", "key": "ram",  "format": "{used} \u001b[38;2;99;99;102m/\u001b[38;2;242;242;242m {total}" },
    { "type": "disk",   "key": "disk", "folders": ["/"], "format": "{size-used} \u001b[38;2;99;99;102m/\u001b[38;2;242;242;242m {size-total}" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;255;95;87m●\u001b[0m \u001b[38;2;254;188;46m●\u001b[0m \u001b[38;2;40;200;64m●" }
  ]
}
