/* Rofi — macOS Spotlight tarzı
   Büyük arama alanı + büyüteç, altında ince ayırıcı; iki satırlı sonuçlar
   (kalın ad + soluk açıklama), büyük ikonlar. Eski: config.rasi.bak-spotlight */

configuration {
  modes: "drun,run,window,ssh";
  show-icons: true;
  icon-theme: "WhiteSur-dark";
  /* Ad kalın; altında soluk açıklama (GenericName, yoksa Comment) */
  drun-display-format: "<span weight='600'>{name}</span>[<span size='9.5pt' foreground='#8e8e93'>&#10;{generic}</span>]";
  display-drun: " 󰀻  Apps ";
  display-run: "   Run ";
  display-window: " 󰖲  Windows ";
  display-ssh: " 󰣀  SSH ";
  font: "Inter, JetBrainsMono Nerd Font Mono Medium 12";
  fixed-num-lines: true;
  matching: "normal";   /* Spotlight gibi sıralı alt metin eşleşmesi */
  sort: true;
  sorting-method: "fzf";
  case-sensitive: false;
  cycle: true;
  sidebar-mode: false;
  hover-select: true;
  eh: 1;
  auto-select: false;
  parse-hosts: true;
  parse-known-hosts: true;
  combi-modes: "window,drun,run";
  window-format: "{w} · {c} · {t}";
}

* {
  /* macOS-style translucent dark; blur comes from SwayFX layer_effects */
  bg:       #0d0d0eba;
  bg-alt:   #ffffff0d;
  bg-sel:   #ffffff1f;
  fg:       #f2f2f2;
  fg-dim:   #a8a8ad;
  fg-sel:   #ffffff;
  border:   #ffffff1a;
  accent:   #ffffff;
  font: "Inter, JetBrainsMono Nerd Font Mono Medium 12";

  /* Kill rofi default (solarized light) colors completely */
  background-color: transparent;
  background: @bg;
  foreground: @fg;
  border-color: @border;
  separatorcolor: @border;
  scrollbarcolor: @border;

  normal-background: transparent;
  normal-foreground: @fg-dim;
  alternate-normal-background: transparent;
  alternate-normal-foreground: @fg-dim;
  selected-normal-background: @bg-sel;
  selected-normal-foreground: @fg-sel;

  urgent-background: transparent;
  urgent-foreground: @fg;
  alternate-urgent-background: transparent;
  alternate-urgent-foreground: @fg;
  selected-urgent-background: @bg-sel;
  selected-urgent-foreground: @fg-sel;

  active-background: transparent;
  active-foreground: @fg;
  alternate-active-background: transparent;
  alternate-active-foreground: @fg;
  selected-active-background: @bg-sel;
  selected-active-foreground: @fg-sel;

  /* Legacy vars some default themes pull in */
  lightbg: @bg;
  lightfg: @bg-sel;
  red: @fg;
  blue: @fg;

  spacing: 0;
}

window {
  background-color: @bg;
  border: 1px;
  border-color: @border;
  border-radius: 16px;
  width: 680px;
  location: north;
  anchor: north;
  x-offset: 0;
  y-offset: 220px;   /* Wayland: % çalışmıyor, px kullan */
  padding: 0px;
}

mainbox {
  background-color: transparent;
  children: [ inputbar, message, listview ];
  spacing: 0;
  padding: 0px;
}

/* ---- Arama alanı (Spotlight) ---- */
inputbar {
  background-color: transparent;
  text-color: @fg;
  border: 0px 0px 1px 0px;     /* sonuçlardan ince çizgiyle ayrılır */
  border-color: @border;
  border-radius: 0px;
  children: [ icon-search, entry ];
  spacing: 12px;
  padding: 16px 20px;
}

icon-search {
  expand: false;
  filename: "system-search-symbolic";
  size: 24px;
  vertical-align: 0.5;
  background-color: transparent;
}

entry {
  background-color: transparent;
  text-color: @fg;
  font: "Inter 19";
  placeholder: "Spotlight'ta Ara";
  placeholder-color: #8e8e93;
  vertical-align: 0.5;
  cursor-color: @fg;
}

prompt {
  enabled: false;
}

/* ---- Mesaj kutusu: hesap makinesi sonucu (rofi-calc) burada görünür ---- */
message {
  background-color: transparent;
  border: 0px 0px 1px 0px;
  border-color: @border;
  padding: 14px 20px;
}

textbox {
  background-color: transparent;
  text-color: @fg;
  font: "Inter Semi-Bold 22";
  vertical-align: 0.5;
}

/* ---- Sonuçlar ---- */
listview {
  background-color: transparent;
  border: 0;          /* varsayılan temanın kesik çizgisini kaldır */
  columns: 1;
  lines: 7;
  spacing: 2px;
  padding: 8px;
  cycle: true;
  dynamic: true;
  fixed-height: true;   /* tüm satırlar aynı yükseklikte */
  layout: vertical;
  scrollbar: false;
}

scrollbar {
  background-color: transparent;
  handle-color: @border;
  handle-width: 4px;
  border: 0px;
  border-radius: 6px;
}

element {
  background-color: transparent;
  text-color: @fg;
  border: 0px;
  border-radius: 9px;
  padding: 7px 12px;
  orientation: horizontal;
  spacing: 12px;
}

element-icon {
  background-color: transparent;
  size: 34px;
  vertical-align: 0.5;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  markup: true;
  highlight: none;
  vertical-align: 0.5;
}

/* Her durum açıkça tanımlı - varsayılan renkler sızmasın */
element normal.normal,
element alternate.normal,
element normal.urgent,
element alternate.urgent,
element normal.active,
element alternate.active {
  background-color: transparent;
  text-color: @fg;
  border: 0px;
  border-radius: 9px;
}

element selected,
element selected.normal,
element selected.urgent,
element selected.active,
element alternate.selected {
  background-color: @bg-sel;
  text-color: @fg-sel;
  border: 0px;
  border-radius: 9px;
}
