#!/usr/bin/env bash
# Rofi duvar kâğıdı seçici (mango)
# - Önizlemeli ızgara, mevcut duvar kâğıdı seçili gelir
# - Seçim anında uygulanır ve ~/.config/mango/wallpaper bağına yazılır (açılışta swaybg bunu okur)
# Kullanım: wallpaper            -> rofi seçici
#           wallpaper dosya.jpg  -> doğrudan uygula
# Klasör: $WALLPAPER_DIR, yoksa ~/Pictures/wallpapers

DIR="${WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
LINK="$HOME/.config/mango/wallpaper"
MODE="fill"

mapfile -t files < <(find "$DIR" -maxdepth 1 -type f \
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -printf '%f\n' 2>/dev/null | sort)
[ ${#files[@]} -eq 0 ] && { notify-send "Duvar kâğıdı" "$DIR içinde resim yok" 2>/dev/null; exit 1; }

if [ -n "$1" ]; then
  path="$DIR/$(basename "$1")"
  [ -f "$path" ] || { echo "Bulunamadı: $path" >&2; exit 1; }
else
  current=$(readlink -f "$LINK" 2>/dev/null)
  active=""
  for i in "${!files[@]}"; do
    [ "$DIR/${files[$i]}" = "$current" ] && active="-selected-row $i"
  done

  choice=$(for f in "${files[@]}"; do
    printf '%s\0icon\x1f%s\n' "$f" "$DIR/$f"
  done | "$HOME/.local/bin/ada-rofi" 900 772 -dmenu -i -p "" -format i $active \
    -theme-str '
      window      { width: 900px; location: center; anchor: center; y-offset: 0; }
      inputbar    { children: [ entry ]; }
      entry       { placeholder: "Duvar kâğıdı ara..."; }
      listview    { columns: 4; lines: 3; spacing: 10px; flow: horizontal; fixed-columns: true; border: 0; }
      element     { orientation: vertical; padding: 10px; spacing: 8px; border-radius: 10px; }
      element-icon { size: 180px; border-radius: 8px; }
      element-text { horizontal-align: 0.5; }
    ')

  [ -z "$choice" ] && exit 0
  path="$DIR/${files[$choice]}"
fi

# Anında uygula: swaybg'yi yeniden başlat
pkill -x swaybg
setsid swaybg -i "$path" -m "$MODE" >/dev/null 2>&1 &

# Kalıcı: bir sonraki açılışta mango aynı bağı okur
mkdir -p "$(dirname "$LINK")"
ln -sfn "$path" "$LINK"

# Kilit ekranının bulanık arka planını yenile
setsid "$HOME/.config/swaylock/make-blur.sh" >/dev/null 2>&1 &
